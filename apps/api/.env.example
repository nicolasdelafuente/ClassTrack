DATABASE_URL="file:./dev.db"

# Runtime environment: production | testing | develop
# Outside production, all outbound mail is redirected to MAIL_REDIRECT_TO.
APP_ENV=develop

# Invite / broadcast emails (CT-042 / CT-043). Leave empty for local “copy link” mode.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@classtrack.local
MAILJET_FROM_NAME=ClassTrack
# Non-production override inbox (validate + dedupe still run first)
MAIL_REDIRECT_TO=ni.delafuente@gmail.com

# Public web URL used in invite links
WEB_APP_URL=http://localhost:5173

# Observability — Pino (nestjs-pino)
# Console: pretty in develop (unless LOG_FORMAT=json); JSON elsewhere.
# File: apps/api/logs/classtrack-api*.jsonl via pino-roll (disable with LOG_TO_FILE=0)
LOG_TO_FILE=1
LOG_DIR=logs
LOG_FILE_NAME=classtrack-api.jsonl
LOG_FILE_MAX_SIZE=5m
LOG_FILE_MAX_FILES=3
# LOG_FORMAT=pretty|json
# LOG_LEVEL=debug|info|warn|error|fatal
