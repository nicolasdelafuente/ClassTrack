DATABASE_URL="file:./dev.db"

# Runtime environment: production | testing | develop
# Outside production, all outbound mail is redirected to MAIL_REDIRECT_TO.
APP_ENV=develop

# Invite / broadcast emails (CT-042 / CT-043). Leave empty for local “copy link” mode.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@classtrack.local
MAILJET_FROM_NAME=ClassTrack
# Non-production override inbox (validate + dedupe still run first)
MAIL_REDIRECT_TO=ni.delafuente@gmail.com

# Public web URL used in invite links
WEB_APP_URL=http://localhost:5173
