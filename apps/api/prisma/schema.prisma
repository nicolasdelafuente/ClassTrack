generator client {
  provider = "prisma-client-js"
}

// SQLite for local demo seed (CT-010). Postgres can replace this in CT-014.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SprintStatusValue {
  unknown
  ok
  attention
  critical
}

enum UserRole {
  teacher
  student
}

/**
 * Demo accounts (CT-038 / CT-039).
 * DEMO ONLY: password stored in plain text — never ship this to production.
 */
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        UserRole @default(teacher)
  displayName String?  @map("display_name")
  /// Linked roster Student (CT-045 / CT-046).
  studentId   String?  @unique @map("student_id")
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invitesSent Invite[] @relation("InvitesSent")
  tutoredGroups Group[] @relation("GroupTutor")
  sheetComments SprintSheetComment[]
  groupNotes  GroupNote[]
  noteAttachments GroupNoteAttachment[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/**
 * Registration invite (CT-042). Email + role locked; token opens /register?token=…
 */
model Invite {
  id              String    @id @default(cuid())
  token           String    @unique
  email           String
  role            UserRole
  courseId        String?   @map("course_id")
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studentId       String?   @map("student_id")
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invitedByUserId String?   @map("invited_by_user_id")
  invitedBy       User?     @relation("InvitesSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([courseId])
  @@map("invites")
}

model Course {
  id                   String                       @id @default(cuid())
  name                 String
  code                 String                       @unique
  isCurrent            Boolean                      @default(false) @map("is_current")
  /// Absences allowed on mandatory classes before libre (default 4 → 5th absence = libre).
  maxAbsencesAllowed   Int                          @default(4) @map("max_absences_allowed")
  /// When true, students may join/leave groups (CT-045).
  groupEnrollmentOpen  Boolean                      @default(false) @map("group_enrollment_open")
  groups               Group[]
  attendanceRecords    AttendanceRecord[]
  classSessions        ClassSession[]
  activityTypeDefaults CourseActivityTypeDefault[]
  invites              Invite[]
  preliminaryGrades    PreliminaryGrade[]
  finalGrades          FinalGrade[]
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@map("courses")
}

model Group {
  id            String          @id @default(cuid())
  courseId      String          @map("course_id")
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number        Int
  name          String?
  projectTopic  String?         @map("project_topic")
  /// Max members for student self-join (CT-045). Teacher override ignores this.
  capacity      Int             @default(4)
  /// Legacy display label; kept in sync when tutorUserId is set.
  teacherName   String?         @map("teacher_name")
  /// Assigned tutor (User with role teacher). CT-044.
  tutorUserId   String?         @map("tutor_user_id")
  tutor         User?           @relation("GroupTutor", fields: [tutorUserId], references: [id], onDelete: SetNull)
  /// Teacher note for the group before final presentation (CT-047).
  preliminaryGroupComment String? @map("preliminary_group_comment")
  memberships   Membership[]
  sprintStatuses SprintStatus[]
  links         GroupLinks?
  leaveLogs     GroupLeaveLog[]
  sprintSheets  SprintSheet[]
  notes         GroupNote[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([courseId, number])
  @@index([tutorUserId])
  @@map("groups")
}

model Student {
  id                String             @id @default(cuid())
  legajo            String?
  fullName          String             @map("full_name")
  email             String?
  user              User?
  memberships       Membership[]
  attendanceRecords AttendanceRecord[]
  invites           Invite[]
  leaveLogs         GroupLeaveLog[]
  preliminaryGrades PreliminaryGrade[]
  finalGrades       FinalGrade[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("students")
}

/// Student left a group with a justification while enrollment was open (CT-045).
model GroupLeaveLog {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String   @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([groupId])
  @@index([studentId])
  @@map("group_leave_logs")
}

model Membership {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  studentId String   @map("student_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([groupId, studentId])
  @@map("memberships")
}

model SprintStatus {
  id           String            @id @default(cuid())
  groupId      String            @map("group_id")
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sprintNumber Int               @map("sprint_number")
  status       SprintStatusValue @default(unknown)
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([groupId, sprintNumber])
  @@map("sprint_statuses")
}

model GroupLinks {
  groupId   String  @id @map("group_id")
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  githubUrl String? @map("github_url")
  trelloUrl String? @map("trello_url")
  driveUrl  String? @map("drive_url")

  @@map("group_links")
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  courseId     String   @map("course_id")
  studentId    String   @map("student_id")
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  present      Boolean  @default(false)
  participated Boolean  @default(false)

  @@unique([courseId, studentId, date])
  @@map("attendance_records")
}

/// One calendar class day for a course (cronograma).
enum ClassActivityType {
  feriado
  sprint_planning
  sprint_review
  seguimiento
  teorica
  presentacion_medio
  presentacion_final
}

/// Whether class.isMandatory was computed from items or set by the teacher.
enum MandatorySource {
  derived
  manual
}

model ClassSession {
  id                String           @id @default(cuid())
  courseId          String           @map("course_id")
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Calendar day of the class (store as date-only midnight).
  date              DateTime
  /// Effective flag used for absence quota (teacher may override).
  isMandatory       Boolean          @default(true) @map("is_mandatory")
  /// `derived` from items; `manual` when the teacher overrides.
  mandatorySource   MandatorySource  @default(derived) @map("mandatory_source")
  /// False for holidays — no attendance roster that day.
  allowsAttendance  Boolean          @default(true) @map("allows_attendance")
  items             ClassSessionItem[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([courseId, date])
  @@index([courseId])
  @@map("class_sessions")
}

model ClassSessionItem {
  id             String            @id @default(cuid())
  classSessionId String            @map("class_session_id")
  classSession   ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  title          String
  sortOrder      Int               @default(0) @map("sort_order")
  activityType   ClassActivityType @map("activity_type")
  /// Item-level mandatory flag (defaults come from type / course params in CT-024+).
  isMandatory    Boolean           @default(true) @map("is_mandatory")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([classSessionId])
  @@map("class_session_items")
}

/// Per-course default: is this activity type mandatory / allows attendance.
model CourseActivityTypeDefault {
  id                   String            @id @default(cuid())
  courseId             String            @map("course_id")
  course               Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activityType         ClassActivityType @map("activity_type")
  isMandatoryByDefault Boolean           @default(true) @map("is_mandatory_by_default")
  allowsAttendance     Boolean           @default(true) @map("allows_attendance")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@unique([courseId, activityType])
  @@index([courseId])
  @@map("course_activity_type_defaults")
}

/// Start or end sprint sheet for a group (CT-046).
enum SheetKind {
  start
  end
}

enum SheetStatus {
  draft
  in_review
  needs_changes
  approved
}

enum TaskCategory {
  backend
  frontend
  documentation
  testing
  devops
  design
  other
}

model SprintSheet {
  id           String              @id @default(cuid())
  groupId      String              @map("group_id")
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sprintNumber Int                 @map("sprint_number")
  kind         SheetKind
  status       SheetStatus         @default(draft)
  submittedAt  DateTime?           @map("submitted_at")
  approvedAt   DateTime?           @map("approved_at")
  tasks        SprintSheetTask[]
  comments     SprintSheetComment[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([groupId, sprintNumber, kind])
  @@index([groupId])
  @@index([status])
  @@map("sprint_sheets")
}

model SprintSheetTask {
  id               String        @id @default(cuid())
  sheetId          String        @map("sheet_id")
  sheet            SprintSheet   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  category         TaskCategory
  title            String
  description      String?
  /// Null on start sheets; required true/false on end (for non-extras) when submitting.
  completed        Boolean?
  incompleteReason String?       @map("incomplete_reason")
  isExtra          Boolean       @default(false) @map("is_extra")
  extraReason      String?       @map("extra_reason")
  /// Points to the start-sheet task this end-row was copied from.
  sourceTaskId     String?       @map("source_task_id")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([sheetId])
  @@map("sprint_sheet_tasks")
}

model SprintSheetComment {
  id           String      @id @default(cuid())
  sheetId      String      @map("sheet_id")
  sheet        SprintSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  authorUserId String      @map("author_user_id")
  author       User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([sheetId])
  @@map("sprint_sheet_comments")
}

/// Pre-presentation grade per student (CT-047). score 1–10 or absent (A).
model PreliminaryGrade {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// 1…10 when graded; null if absent or unset.
  score     Int?
  isAbsent  Boolean  @default(false) @map("is_absent")
  comment   String?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([courseId, studentId])
  @@index([courseId])
  @@map("preliminary_grades")
}

/// Final grade per student (CT-048). score 1–10 or absent (A).
model FinalGrade {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Int?
  isAbsent  Boolean  @default(false) @map("is_absent")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([courseId, studentId])
  @@index([courseId])
  @@map("final_grades")
}

/// Teacher follow-up note on a group (CT-049). Photos → CT-050.
model GroupNote {
  id           String                @id @default(cuid())
  groupId      String                @map("group_id")
  group        Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorUserId String                @map("author_user_id")
  author       User                  @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  /// Display title (preset text or free text chosen by the teacher).
  title        String
  body         String
  attachments  GroupNoteAttachment[]
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([groupId, createdAt])
  @@map("group_notes")
}

/// Image attached to a group note (CT-050). Files live under uploads/.
model GroupNoteAttachment {
  id               String    @id @default(cuid())
  noteId           String    @map("note_id")
  note             GroupNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedBy       User      @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  /// Stored filename on disk (unique).
  storedName       String    @map("stored_name")
  originalName     String    @map("original_name")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([noteId])
  @@map("group_note_attachments")
}
