generator client {
  provider = "prisma-client-js"
}

// SQLite for local demo seed (CT-010). Postgres can replace this in CT-014.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SprintStatusValue {
  unknown
  ok
  attention
  critical
}

enum UserRole {
  teacher
  student
}

/**
 * Demo accounts (CT-038 / CT-039).
 * DEMO ONLY: password stored in plain text — never ship this to production.
 */
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        UserRole @default(teacher)
  displayName String?  @map("display_name")
  invitesSent Invite[] @relation("InvitesSent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/**
 * Registration invite (CT-042). Email + role locked; token opens /register?token=…
 */
model Invite {
  id              String    @id @default(cuid())
  token           String    @unique
  email           String
  role            UserRole
  courseId        String?   @map("course_id")
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studentId       String?   @map("student_id")
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invitedByUserId String?   @map("invited_by_user_id")
  invitedBy       User?     @relation("InvitesSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([courseId])
  @@map("invites")
}

model Course {
  id                   String                       @id @default(cuid())
  name                 String
  code                 String                       @unique
  isCurrent            Boolean                      @default(false) @map("is_current")
  /// Absences allowed on mandatory classes before libre (default 4 → 5th absence = libre).
  maxAbsencesAllowed   Int                          @default(4) @map("max_absences_allowed")
  groups               Group[]
  attendanceRecords    AttendanceRecord[]
  classSessions        ClassSession[]
  activityTypeDefaults CourseActivityTypeDefault[]
  invites              Invite[]
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@map("courses")
}

model Group {
  id            String          @id @default(cuid())
  courseId      String          @map("course_id")
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number        Int
  name          String?
  projectTopic  String?         @map("project_topic")
  teacherName   String?         @map("teacher_name")
  memberships   Membership[]
  sprintStatuses SprintStatus[]
  links         GroupLinks?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([courseId, number])
  @@map("groups")
}

model Student {
  id                String             @id @default(cuid())
  legajo            String?
  fullName          String             @map("full_name")
  email             String?
  memberships       Membership[]
  attendanceRecords AttendanceRecord[]
  invites           Invite[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("students")
}

model Membership {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  studentId String   @map("student_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([groupId, studentId])
  @@map("memberships")
}

model SprintStatus {
  id           String            @id @default(cuid())
  groupId      String            @map("group_id")
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sprintNumber Int               @map("sprint_number")
  status       SprintStatusValue @default(unknown)
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([groupId, sprintNumber])
  @@map("sprint_statuses")
}

model GroupLinks {
  groupId   String  @id @map("group_id")
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  githubUrl String? @map("github_url")
  trelloUrl String? @map("trello_url")
  driveUrl  String? @map("drive_url")

  @@map("group_links")
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  courseId     String   @map("course_id")
  studentId    String   @map("student_id")
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  present      Boolean  @default(false)
  participated Boolean  @default(false)

  @@unique([courseId, studentId, date])
  @@map("attendance_records")
}

/// One calendar class day for a course (cronograma).
enum ClassActivityType {
  feriado
  sprint_planning
  sprint_review
  seguimiento
  teorica
  presentacion_medio
  presentacion_final
}

/// Whether class.isMandatory was computed from items or set by the teacher.
enum MandatorySource {
  derived
  manual
}

model ClassSession {
  id                String           @id @default(cuid())
  courseId          String           @map("course_id")
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Calendar day of the class (store as date-only midnight).
  date              DateTime
  /// Effective flag used for absence quota (teacher may override).
  isMandatory       Boolean          @default(true) @map("is_mandatory")
  /// `derived` from items; `manual` when the teacher overrides.
  mandatorySource   MandatorySource  @default(derived) @map("mandatory_source")
  /// False for holidays — no attendance roster that day.
  allowsAttendance  Boolean          @default(true) @map("allows_attendance")
  items             ClassSessionItem[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([courseId, date])
  @@index([courseId])
  @@map("class_sessions")
}

model ClassSessionItem {
  id             String            @id @default(cuid())
  classSessionId String            @map("class_session_id")
  classSession   ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  title          String
  sortOrder      Int               @default(0) @map("sort_order")
  activityType   ClassActivityType @map("activity_type")
  /// Item-level mandatory flag (defaults come from type / course params in CT-024+).
  isMandatory    Boolean           @default(true) @map("is_mandatory")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([classSessionId])
  @@map("class_session_items")
}

/// Per-course default: is this activity type mandatory / allows attendance.
model CourseActivityTypeDefault {
  id                   String            @id @default(cuid())
  courseId             String            @map("course_id")
  course               Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activityType         ClassActivityType @map("activity_type")
  isMandatoryByDefault Boolean           @default(true) @map("is_mandatory_by_default")
  allowsAttendance     Boolean           @default(true) @map("allows_attendance")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@unique([courseId, activityType])
  @@index([courseId])
  @@map("course_activity_type_defaults")
}
